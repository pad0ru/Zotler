{
  "manifest_version": 3,
  "name": "Zotler \u2014 UCI AI Academic Planner",
  "short_name": "Zotler",
  "version": "0.2.0",
  "description": "AI-powered academic planning assistant for UCI students. Ask questions about your degree, majors, minors, and graduation timeline.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "zotler@pad0ru.dev",
      "strict_min_version": "115.0"
    }
  },
  "action": {
    "default_title": "Open Zotler",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "sidebar_action": {
    "default_panel": "sidebar.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    },
    "default_title": "Zotler"
  },
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "permissions": [
    "storage",
    "sidePanel",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://anteaterapi.com/*",
    "https://antalmanac.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "content_scripts": [
    {
      "matches": [
        "https://antalmanac.com/*"
      ],
      "js": [
        "antalmanac-import.js",
        "antalmanac-sync.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
