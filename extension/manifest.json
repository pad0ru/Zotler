{
  "manifest_version": 3,
  "name": "Zotler — UCI AI Academic Planner",
  "short_name": "Zotler",
  "version": "0.2.0",
  "description": "AI-powered academic planning assistant for UCI students. Ask questions about your degree, majors, minors, and graduation timeline.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open Zotler",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png" }
  },
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "sidePanel",
    "activeTab",
    "tabs"
  ],
  "host_permissions": ["https://prod.assistng.org/*", "https://generativelanguage.googleapis.com/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": ["lib/pdf.worker.min.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
